# Telegram bot token — get it from @BotFather on Telegram
BOT_TOKEN=

# OpenRouter API key — get it from openrouter.ai
OPENROUTER_API_KEY=

# Optional: OpenRouter model override. Defaults to openai/gpt-4o-mini
OPENROUTER_MODEL=

# PostgreSQL connection string
# Local example: postgresql://postgres:postgres@localhost:5432/anw_weather_ai_bot
# Railway: copy the DATABASE_URL from your Railway PostgreSQL service
DATABASE_URL=
